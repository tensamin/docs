---
import { getCollection } from "astro:content";

const pages = await getCollection(
  "docs",
  ({ id, data }) => !data.draft && id !== "index" && id !== "404",
);
const entries = pages.map((page) => ({
  page,
  directory: page.id.includes("/") ? page.id.split("/")[0] : "",
}));
const groups = [
  { directory: "", title: "Start here" },
  { directory: "using", title: "Using Tensamin" },
  { directory: "hosting", title: "Hosting an Iota" },
  { directory: "developers", title: "Integrate TAuth" },
];

for (const { directory } of entries) {
  if (!groups.some((group) => group.directory === directory)) {
    groups.push({ directory, title: directory.replaceAll("-", " ") });
  }
}

const sections = groups.map((group) => ({
  ...group,
  pages: entries
    .filter(({ directory }) => directory === group.directory)
    .map(({ page }) => page)
    .sort((a, b) => (a.data.sidebar.order ?? Infinity) - (b.data.sidebar.order ?? Infinity) || a.id.localeCompare(b.id)),
}));
---

<div class="docs-index">
  {sections.filter((section) => section.pages.length).map((section) => (
    <section>
      <h2>{section.title}</h2>
      <ul>
        {section.pages.map((page) => (
          <li><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${page.id.replace(/\/index$/, "")}/`}>{page.data.sidebar.label ?? page.data.title}</a></li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .docs-index h2 {
    margin-block: 0 0.75rem;
    font-size: var(--sl-text-h2);
    line-height: 1.3;
  }

  .docs-index section + section {
    margin-top: 2rem;
  }

  .docs-index a {
    font-size: 1.125rem;
  }
</style>
